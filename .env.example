# ── Demo feature flags (optional) ───────────────────────────
NEXT_PUBLIC_FLAG_TRY_ON=true
NEXT_PUBLIC_FLAG_TECHNICAL=true
NEXT_PUBLIC_FLAG_DEMO=true

# ── Phase 6 Track B: secure backend (server-only; never NEXT_PUBLIC_) ──
# Local values for docker-compose.dev.yml live in .env.local (git-ignored).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
S3_ENDPOINT=                      # omit for AWS S3; set for R2/SeaweedFS/other S3-compatible stores
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
AUTH_SECRET=                      # 32+ random characters (e.g. `openssl rand -base64 48`)
RETENTION_CRON_SECRET=            # 24+ random characters; used by the scheduled retention job
APP_ORIGIN=https://your-app.example.com
INFERENCE_PROVIDER=none           # none | modal (6C, after approval). "fake" is test-only.
USER_HOURLY_GENERATION_LIMIT=20
DEFAULT_ORG_MONTHLY_BUDGET_USD=25
GLOBAL_MONTHLY_LIMIT_USD=100
COST_PER_IMAGE_USD=0.02
MAX_UPLOAD_BYTES=8388608
